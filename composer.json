{
    "name": "open-dxp/skeleton",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/ai-mate-composer-plugin": true,
            "symfony/runtime": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require": {
        "open-dxp/opendxp": "^1.5",
        "symfony/dotenv": "^7.4",
        "symfony/runtime": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "open-dxp/mate-extension": "^1.0",
        "open-dxp/test-foundation": "^1.2.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "suggest": {
        "open-dxp/data-hub-bundle": "Universal data interface for GraphQL, CSV and other formats",
        "symfony/ai-symfony-mate-extension": "Gives AI agents container and profiler tools through Mate, see README.md",
        "symfony/amqp-messenger": "Enables the optional RabbitMQ Messenger transport"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "OpenDxp\\Model\\DataObject\\": "var/classes/DataObject"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": "OpenDxp\\Composer::postCreateProject",
        "post-install-cmd": [
            "OpenDxp\\Composer::postInstall",
            "@opendxp-scripts"
        ],
        "post-update-cmd": [
            "OpenDxp\\Composer::postUpdate",
            "@opendxp-scripts"
        ],
        "opendxp-scripts": [
            "OpenDxp\\Composer::clearCache",
            "OpenDxp\\Composer::installAssets"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "recurse": true,
            "replace": true,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-replace": true,
            "merge-scripts": false
        }
    }
}
